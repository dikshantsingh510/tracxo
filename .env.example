# ============================================================================
# Tracxo environment variables  (docs/PROMPT.md §16)
# Copy to .env.local for dev. Never commit secrets. Never log PII.
# ============================================================================

# ---- Database -------------------------------------------------------------
# Neon Postgres (HTTP driver, pooled). Free tier: 0.5 GB.
# Format: postgres://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL="postgres://user:password@ep-xxx.region.aws.neon.tech/tracxo?sslmode=require"

# ---- Auth (Better Auth) ---------------------------------------------------
# 32+ char random secret. Generate: `openssl rand -hex 32`
BETTER_AUTH_SECRET="replace-me-32-byte-hex"
# Public origin used for OAuth callbacks + email magic links.
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Email (Resend) -------------------------------------------------------
# Free tier: 3000/mo, 100/day. Verify domain at resend.com/domains.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Tracxo <hello@your-verified-domain.example>"

# ---- Vercel Cron ----------------------------------------------------------
# Random secret protecting /api/cron/* endpoints.
CRON_SECRET="replace-me-random"

# ---- Public client config -------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Bump to bust unstable_cache + 'use cache' values across deploys.
NEXT_PUBLIC_CACHE_VERSION="v1"

# ---- Vercel Blob (receipt attachments) ------------------------------------
BLOB_READ_WRITE_TOKEN=""

# ---- Observability --------------------------------------------------------
# Sentry Developer plan: 5000 events/mo.
SENTRY_DSN=""
# Optional: enables source-map upload during build.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT="tracxo"
